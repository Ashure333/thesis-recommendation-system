{
  "name": "research-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -b tsconfig.node.json --force",
    "check": "npm run typecheck && npm run check:inline-scripts",
    "check:inline-scripts": "node scripts/check-inline-scripts.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "katex": "^0.18.10",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icon": "^1.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
