{
  "manifest_version": 3,
  "name": "Re:Search Google Scholar Importer",
  "version": "1.0.0",
  "description": "Imports Google Scholar BibTeX citations into Re:Search.",
  "minimum_chrome_version": "110",
  "permissions": [],
  "host_permissions": [
    "https://scholar.googleusercontent.com/*",
    "https://scholar.google.com/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}